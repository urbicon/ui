{
  "name": "urbicon-ui",
  "version": "6.51.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbicon/ui.git"
  },
  "homepage": "https://ui.urbicon.de",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@sveltejs/adapter-static": "^3.0.10",
      "@sveltejs/kit": "^2.70.2",
      "@sveltejs/package": "^2.5.8",
      "@sveltejs/vite-plugin-svelte": "^7.0.0",
      "@tailwindcss/node": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^26.1.2",
      "estree-walker": "^3.0.3",
      "glob": "^13.0.6",
      "prettier": "^3.9.6",
      "prettier-plugin-svelte": "^4.1.1",
      "prettier-plugin-tailwindcss": "^0.8.1",
      "shiki": "^4.4.1",
      "svelte": "^5.56.8",
      "svelte-check": "^4.7.4",
      "tailwindcss": "^4.3.3",
      "tsx": "^4.23.1",
      "typescript": "^6.0.3",
      "vite": "^8.2.0",
      "vitest": "^4.1.9",
      "@commitlint/cli": "^21.2.1",
      "git-cliff": "^2.13.1",
      "@types/bun": "^1.3.14",
      "@biomejs/biome": "^2.5.6",
      "lefthook": "^2.1.10",
      "jsdom": "^30.0.1",
      "@testing-library/dom": "^10.4.1",
      "@testing-library/user-event": "^14.6.1"
    }
  },
  "trustedDependencies": [
    "@urbicon-ui/blocks",
    "@urbicon-ui/design",
    "@urbicon-ui/design-content",
    "@urbicon-ui/design-engine",
    "@urbicon-ui/docs",
    "@urbicon-ui/docs-gen",
    "@urbicon-ui/table",
    "@urbicon-ui/shared-types",
    "@urbicon-ui/sveltekit-utils",
    "@urbicon-ui/i18n",
    "@urbicon-ui/auth"
  ],
  "scripts": {
    "bump": "bash scripts/bump.sh patch",
    "bump:patch": "bash scripts/bump.sh patch",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "changelog": "git-cliff --output CHANGELOG.md",
    "release:publish": "bash scripts/publish.sh",
    "dev": "bun --filter='*' run dev",
    "dev:blocks": "bun --filter='@urbicon-ui/blocks' run dev",
    "dev:docs": "bun --filter='@urbicon-ui/docs' run dev",
    "dev:docs-gen": "bun --filter='@urbicon-ui/docs-gen' run dev",
    "dev:table": "bun --filter='@urbicon-ui/table' run dev",
    "dev:i18n": "bun --filter='@urbicon-ui/i18n' run dev",
    "dev:app-docs": "bun --filter='@urbicon-ui/docs-app' run dev",
    "docs:gen": "bun --bun --filter='@urbicon-ui/docs-gen' run docs:gen",
    "docs:gen:ci": "bun --bun --filter='@urbicon-ui/docs-gen' run docs:gen",
    "docs:gen:blocks": "cd packages/docs-gen && bun src/cli/index.ts generate --target blocks",
    "docs:gen:docs": "cd packages/docs-gen && bun src/cli/index.ts generate --target docs",
    "docs:gen:table": "cd packages/docs-gen && bun src/cli/index.ts generate --target table",
    "docs:gen:auth": "cd packages/docs-gen && bun src/cli/index.ts generate --target auth",
    "docs:gen:all": "cd packages/docs-gen && bun src/cli/index.ts generate --target all",
    "channels:gen": "bun apps/docs/scripts/channels-gen.ts",
    "docs:scaffold": "cd packages/docs-gen && bun src/cli/index.ts scaffold",
    "build:ts": "bun --bun run scripts/build-packages.ts && bun docs:gen:ci",
    "build": "bun run build:ts && bun --bun --filter='./apps/*' run build",
    "build:packages": "bun --bun --filter='./packages/*' run build",
    "build:docs": "bun --bun --filter='./packages/docs' run build",
    "build:blocks": "bun --bun --filter='./packages/blocks' run build",
    "build:table": "bun --bun --filter='./packages/table' run build",
    "build:i18n": "bun --bun --filter='./packages/i18n' run build",
    "build:shared-types": "bun --bun --filter='./packages/shared-types' run build",
    "build:apps": "bun --bun --filter='./apps/*' run build",
    "build:mcp-dist": "bun --bun run scripts/bundle-mcp.ts",
    "check": "bun --bun --filter='*' run check",
    "clean": "bun --bun --filter='*' run clean",
    "clean-all": "bun --bun --filter='*' run clean-all && rm -rf node_modules && rm bun.lock",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun --bun --filter='*' run test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "i18n:check": "bun --filter='@urbicon-ui/i18n' run build && bun packages/design/src/cli/index.ts i18n audit packages/blocks/src packages/table/src packages/docs/src --translations packages/blocks/src/lib/translations,packages/table/src/lib/translations,packages/docs/src/lib/translations",
    "icons:lint": "bun --bun run packages/blocks/scripts/icons-lint.ts",
    "imports:lint": "bun --bun run packages/blocks/scripts/imports-lint.ts",
    "size": "bun --bun run scripts/bundle-size.ts",
    "variants:lint": "bun --bun run packages/blocks/scripts/variants-lint.ts",
    "a2ui:axes": "bun --bun run scripts/a2ui-axes-gen.ts",
    "a2ui:axes:check": "bun --bun run scripts/a2ui-axes-gen.ts --check",
    "types:guard": "bun --bun run scripts/types-guard.ts",
    "mcp:start": "bun run packages/mcp-server/src/index.ts",
    "mcp:start:http": "bun run packages/mcp-server/src/index.ts --transport http --port 3001",
    "fix": "biome check --write .",
    "prepare": "lefthook install || true",
    "playgrounds:lint": "bun --filter='@urbicon-ui/docs-app' run playgrounds:lint",
    "registry:lint": "bun --filter='@urbicon-ui/docs-app' run registry:lint",
    "summary:lint": "bun run packages/docs-gen/scripts/summary-lint.ts",
    "examples:lint": "bun run packages/docs-gen/scripts/examples-lint.ts",
    "examples:budget": "bun --filter='@urbicon-ui/docs-app' run examples:budget",
    "sections:lint": "bun --filter='@urbicon-ui/docs-app' run sections:lint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@playwright/test": "^1.62.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@urbicon-ui/biome-config": "^0.3.1",
    "@urbicon-ui/commitlint-config": "^0.3.1",
    "git-cliff": "catalog:",
    "lefthook": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
