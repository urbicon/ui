{
  "name": "urbicon-ui",
  "version": "6.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/urbicon/ui.git"
  },
  "homepage": "https://ui.urbicon.de",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@sveltejs/adapter-static": "^3.0.10",
      "@sveltejs/kit": "^2.57.1",
      "@sveltejs/package": "^2.5.7",
      "@sveltejs/vite-plugin-svelte": "^7.0.0",
      "@tailwindcss/vite": "^4.2.2",
      "@types/node": "^25.9.3",
      "chokidar": "^5.0.0",
      "esm-env": "^1.2.2",
      "estree-walker": "^3.0.3",
      "glob": "^13.0.6",
      "prettier": "^3.8.4",
      "prettier-plugin-svelte": "^4.0.1",
      "prettier-plugin-tailwindcss": "^0.8.0",
      "shiki": "^4.0.2",
      "svelte": "^5.55.4",
      "svelte-check": "^4.4.6",
      "tailwindcss": "^4.2.2",
      "tsx": "^4.21.0",
      "typescript": "^6.0.3",
      "vite": "^8.0.8",
      "vitest": "^4.1.4",
      "@commitlint/cli": "^21.0.2",
      "git-cliff": "^2.13.1",
      "@types/bun": "^1.3.14",
      "@biomejs/biome": "^2.5.0",
      "lefthook": "^2.1.9"
    }
  },
  "trustedDependencies": [
    "@urbicon-ui/blocks",
    "@urbicon-ui/docs",
    "@urbicon-ui/docs-gen",
    "@urbicon-ui/table",
    "@urbicon-ui/shared-types",
    "@urbicon-ui/sveltekit-utils",
    "@urbicon-ui/i18n",
    "@urbicon-ui/auth"
  ],
  "scripts": {
    "bump": "bash scripts/bump.sh patch",
    "bump:patch": "bash scripts/bump.sh patch",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "changelog": "git-cliff --output CHANGELOG.md",
    "dev": "bun --filter='*' run dev",
    "dev:blocks": "bun --filter='@urbicon-ui/blocks' run dev",
    "dev:docs": "bun --filter='@urbicon-ui/docs' run dev",
    "dev:docs-gen": "bun --filter='@urbicon-ui/docs-gen' run dev",
    "dev:table": "bun --filter='@urbicon-ui/table' run dev",
    "dev:i18n": "bun --filter='@urbicon-ui/i18n' run dev",
    "dev:app-docs": "bun --filter='@urbicon-ui/docs-app' run dev",
    "docs:gen": "bun --bun --filter='@urbicon-ui/docs-gen' run docs:gen",
    "docs:gen:ci": "bun --bun --filter='@urbicon-ui/docs-gen' run docs:gen",
    "docs:gen:blocks": "cd packages/docs-gen && bun src/cli/index.ts generate --target blocks",
    "docs:gen:docs": "cd packages/docs-gen && bun src/cli/index.ts generate --target docs",
    "docs:gen:table": "cd packages/docs-gen && bun src/cli/index.ts generate --target table",
    "docs:gen:auth": "cd packages/docs-gen && bun src/cli/index.ts generate --target auth",
    "docs:gen:all": "cd packages/docs-gen && bun src/cli/index.ts generate --target all",
    "docs:scaffold": "cd packages/docs-gen && bun src/cli/index.ts scaffold",
    "build": "bun --bun --filter='./packages/shared-types' run build && bun --bun --filter='./packages/*' run build && bun docs:gen:ci && bun --bun --filter='./apps/*' run build",
    "build:ts": "bun --bun --filter='./packages/shared-types' run build && bun --bun --filter='./packages/docs-gen' run build",
    "build:packages": "bun --bun --filter='./packages/*' run build",
    "build:docs": "bun --bun --filter='./packages/docs' run build",
    "build:blocks": "bun --bun --filter='./packages/blocks' run build",
    "build:table": "bun --bun --filter='./packages/table' run build",
    "build:i18n": "bun --bun --filter='./packages/i18n' run build",
    "build:shared-types": "bun --bun --filter='./packages/shared-types' run build",
    "build:apps": "bun --bun --filter='./apps/*' run build",
    "check": "bun --bun --filter='*' run check",
    "clean": "bun --bun --filter='*' run clean",
    "clean-all": "bun --bun --filter='*' run clean-all && rm -rf node_modules && rm bun.lock",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun --bun --filter='*' run test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "i18n:analyze": "bun --bun run packages/blocks/scripts/i18n-analyzer.js",
    "i18n:check": "bun --bun run i18n:analyze packages/blocks packages/table",
    "icons:lint": "bun --bun run packages/blocks/scripts/icons-lint.ts",
    "mcp:start": "bun run packages/mcp-server/src/index.ts",
    "mcp:start:http": "bun run packages/mcp-server/src/index.ts --transport http --port 3001",
    "fix": "biome check --write .",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@playwright/test": "^1.60.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@urbicon/biome-config": "^0.2.7",
    "@urbicon/commitlint-config": "^0.2.7",
    "git-cliff": "catalog:",
    "lefthook": "catalog:",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
