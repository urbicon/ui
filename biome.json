{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["@urbicon-ui/biome-config/biome-base.json"],
  "files": {
    "includes": [
      "!**/*.svelte",
      "!**/*.svg",
      "!**/*.css",
      "!**/*.gen.ts",
      "!**/replay/*-fixture.json",
      "!**/CHANGELOG.md"
    ]
  },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "performance": { "useTopLevelRegex": "off" },
      "nursery": { "useExplicitReturnType": "off" },
      "suspicious": { "noShadow": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/conformance*.ts", "**/tests/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off", "noTemplateCurlyInString": "off" }
        }
      }
    },
    {
      "includes": ["**/tests/fixtures/**"],
      "linter": {
        "rules": {
          "complexity": { "noBannedTypes": "off" },
          "suspicious": { "noEmptyInterface": "off" }
        }
      }
    }
  ]
}
