{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["@urbicon-ui/biome-config/biome-base.json"],
  "files": {
    "includes": [
      "!**/*.svg",
      "!**/*.css",
      "!**/*.gen.ts",
      "!**/replay/*-fixture.json",
      "!**/CHANGELOG.md"
    ]
  },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "yaml": { "formatter": { "quoteStyle": "single" } },
  "html": { "experimentalFullSupportEnabled": true },
  "linter": {
    "rules": {
      "performance": { "useTopLevelRegex": "off" },
      "nursery": { "useExplicitReturnType": "off" },
      "suspicious": { "noShadow": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/conformance*.ts", "**/tests/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off", "noTemplateCurlyInString": "off" }
        }
      }
    },
    {
      "includes": ["**/tests/fixtures/**"],
      "linter": {
        "rules": {
          "complexity": { "noBannedTypes": "off" },
          "suspicious": { "noEmptyInterface": "off" }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "nursery": {
            "noSvelteAtHtmlTags": "error",
            "noSvelteClassDirective": "error",
            "noSvelteExportLet": "error",
            "useSvelteKitResolve": "error",
            "useSvelteReactiveClasses": "error",
            "useSvelteRequireEachKey": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "preset": "none",
          "correctness": { "noUnusedVariables": "off" },
          "suspicious": { "noShadow": "off" }
        }
      }
    }
  ]
}
