{
  "name": "@urbicon-ui/docs-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && vite build && bun scripts/build-search-index.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "rm -rf dist .svelte-kit",
    "clean-all": "bun --bun run clean && rm -rf node_modules",
    "dev": "vite dev",
    "examples:budget": "bun scripts/example-budget-lint.ts",
    "format": "biome format --write . && prettier --write \"**/*.svelte\"",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "playgrounds:lint": "bun run scripts/playgrounds-lint.ts",
    "preview": "vite preview",
    "registry:lint": "bun run scripts/registry-lint.ts",
    "sections:lint": "bun scripts/sections-lint.ts",
    "test": "vitest run",
    "typesref:lint": "bun scripts/typesref-lint.ts"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@urbicon-ui/auth": "workspace:*",
    "@urbicon-ui/blocks": "workspace:*",
    "@urbicon-ui/docs": "workspace:*",
    "@urbicon-ui/i18n": "workspace:*",
    "@urbicon-ui/shared-types": "workspace:*",
    "@urbicon-ui/sveltekit-utils": "workspace:*",
    "@urbicon-ui/table": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "glob": "catalog:",
    "marked": "^18.0.9",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
