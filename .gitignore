# Auto-generated API docs
apps/docs/src/**/api.ts
apps/docs/static/**/*.txt
!apps/docs/static/robots.txt
apps/docs/static/**/_catalog.json
# generated guide copies distributed by docs-gen (source: packages/*/docs/)
apps/docs/static/**/*.md
apps/docs/static/mcp/
llms-full.txt

# Generated design-content bundle (built at publish-time by docs-gen, shipped in the package)
packages/design-content/content/

# Internal working docs (strategy, launch, deployment, design) — kept local, not part of the published OSS repo
docs/internal/

# Internal A/B research artifacts — not build input, not shipped
experiment/

# Measurement workbench for the artifact track (recorder, fixtures, showcase player)
# — kept local; the tracked source of the shared tools is apps/artifact-studio/
prototypes/

# Completed plans & audits (historical working docs) — kept local, not part of the published OSS repo
docs/archive/
# Packed tarballs from scripts/pack-release.ts — a release artefact, never committed
release-tarballs/
# Bundled MCP server from scripts/bundle-mcp.ts — a deploy artefact, never committed
mcp-dist/

# Playwright shard reports — merged in CI, never committed
blob-report/
all-blob-reports/
