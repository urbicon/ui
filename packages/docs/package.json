{
  "name": "@urbicon-ui/docs",
  "version": "8.15.0",
  "description": "Reusable documentation UI components for Urbicon UI docs sites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbicon/ui.git",
    "directory": "packages/docs"
  },
  "homepage": "https://ui.urbicon.de",
  "bugs": "https://github.com/urbicon/ui/issues",
  "keywords": [
    "svelte",
    "documentation",
    "ui",
    "components"
  ],
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@shikijs/langs": "^4.4.3",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@urbicon-ui/blocks": "workspace:*",
    "@urbicon-ui/i18n": "workspace:*",
    "@urbicon-ui/shared-types": "workspace:*",
    "@urbicon-ui/table": "workspace:*",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "shiki": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style/index.css": "./dist/style/index.css",
    "./vite": {
      "types": "./dist/utils/code-example-plugin.d.ts",
      "default": "./dist/utils/code-example-plugin.js"
    }
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__fixtures__/**"
  ],
  "main": "./dist/index.js",
  "peerDependencies": {
    "svelte": "catalog:",
    "shiki": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@urbicon-ui/blocks": "^8.0.0",
    "@urbicon-ui/table": "^8.0.0",
    "@urbicon-ui/i18n": "^8.0.0",
    "@urbicon-ui/shared-types": "^8.0.0"
  },
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-kit sync && svelte-package && bun ../../scripts/complete-esm-specifiers.ts dist",
    "clean": "rm -rf dist .svelte-kit",
    "clean-all": "bun --bun run clean && rm -rf node_modules",
    "package": "svelte-kit sync && svelte-package && bun ../../scripts/complete-esm-specifiers.ts dist",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "format": "biome format --write . && prettier --write \"**/*.svelte\"",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json"
  },
  "sideEffects": [
    "./src/**/*.css",
    "./dist/**/*.css"
  ],
  "svelte": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts"
}
