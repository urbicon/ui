{
  "name": "@urbicon-ui/auth",
  "version": "6.48.0",
  "description": "Authentication for SvelteKit — JWT sessions, passkeys/WebAuthn, notifications and email with zero runtime dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbicon/ui.git",
    "directory": "packages/auth"
  },
  "homepage": "https://ui.urbicon.de",
  "bugs": "https://github.com/urbicon/ui/issues",
  "keywords": [
    "sveltekit",
    "auth",
    "authentication",
    "webauthn",
    "passkeys",
    "jwt"
  ],
  "type": "module",
  "private": false,
  "sideEffects": [
    "./dist/i18n/index.js",
    "./dist/i18n/index.d.ts"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/adapters/prisma": {
      "types": "./dist/server/adapters/prisma.d.ts",
      "import": "./dist/server/adapters/prisma.js"
    },
    "./server/adapters/in-memory": {
      "types": "./dist/server/adapters/in-memory.d.ts",
      "import": "./dist/server/adapters/in-memory.js"
    },
    "./server/adapters/conformance": {
      "types": "./dist/server/adapters/conformance.d.ts",
      "import": "./dist/server/adapters/conformance.js"
    },
    "./server/adapters/conformance-core": {
      "types": "./dist/server/adapters/conformance-core.d.ts",
      "import": "./dist/server/adapters/conformance-core.js"
    },
    "./server/email/lettermint": {
      "types": "./dist/server/email/lettermint.d.ts",
      "import": "./dist/server/email/lettermint.js"
    },
    "./server/email/console": {
      "types": "./dist/server/email/console.d.ts",
      "import": "./dist/server/email/console.js"
    },
    "./sw": {
      "types": "./dist/sw/index.d.ts",
      "import": "./dist/sw/index.js"
    },
    "./i18n/en": {
      "types": "./dist/i18n/en.d.ts",
      "import": "./dist/i18n/en.js"
    },
    "./i18n/de": {
      "types": "./dist/i18n/de.d.ts",
      "import": "./dist/i18n/de.js"
    }
  },
  "files": [
    "LICENSE",
    "docs/AUTH.md",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*test-utils.*",
    "!dist/**/.svelte-kit"
  ],
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-kit sync && svelte-package",
    "clean": "rm -rf dist .svelte-kit",
    "clean-all": "bun --bun run clean && rm -rf node_modules",
    "package": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome format --write . && prettier --write \"**/*.svelte\"",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@urbicon-ui/blocks": "^6.0.0",
    "@urbicon-ui/i18n": "^6.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@urbicon-ui/blocks": "workspace:*",
    "@urbicon-ui/i18n": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
