%% ==========================================
%% docs-gen class diagram — rewritten 2026-07-27 against the sources.
%%
%% The previous version dated from 2025-08-13 and had rotted past being usable:
%% 18 of its 33 classes no longer existed (SveltePageGenerator and the whole
%% SectionRenderer / TemplateEngine / DocumentationSectionRenderer family,
%% SectionMerger, DeploymentManager, CrossReferenceResolver, ExampleValidator,
%% MetadataEnricher, FileStructureAnalyzer, MetadataExtractor, LLMFormatter,
%% TailwindVariantsParser), while 11 real ones were missing entirely.
%%
%% To keep it from rotting the same way, this version lists only the members
%% that carry the architecture — phase entry points and the seams between
%% classes — not every field and helper. Full signatures live in the sources;
%% a diagram that duplicates them is a second copy that will drift.
%% ==========================================
classDiagram

%% ---------- CLI + configuration ----------
    class DocsGeneratorCLI {
        +run(args) Promise~void~
        -generateTarget(target) Promise~void~
        -assembleLlmsFull() Promise~void~
    }
    class ConfigurationFactory {
        +createDefault() GeneratorConfig
    }
    class DocsConfigurationBuilder {
        +addPackage(PackageConfig) DocsConfigurationBuilder
        +setTypeScript(TypeScriptConfig) DocsConfigurationBuilder
        +enableParallel() DocsConfigurationBuilder
    }

%% ---------- Pipeline ----------
    class PipelineOrchestrator {
        -errorHandler: ErrorHandler
        +execute() Promise~GenerationResult~
        -discoveryPhase() Promise~ComponentManifest[]~
        -extractionPhase(manifests) Promise~ComponentInfo[]~
        -enrichmentPhase(components) Promise~EnrichmentResult~
        -generationPhase(components, apiData) Promise~GenerationResult~
    }
    class ErrorHandler {
        +reportError(PipelineError) void
        +reportWarning(PipelineWarning) void
        +setContext(context) void
    }
    class PipelineException

%% ---------- Phase 1 — Discovery ----------
    class ComponentFinder {
        +findComponents(PackageConfig) Promise~ComponentManifest[]~
        +getPackageInfo(packagePath) Promise~PackageInfo~
    }

%% ---------- Phase 2 — Extraction ----------
    class ExtractionCoordinator {
        +extractAllComponents(manifests) Promise~ComponentInfo[]~
        +extractComponent(manifest) Promise~ComponentInfo~
        +generateExtractionStats(components)
    }
    class ExtractorFactory {
        +getInstance(tsConfig)$ ExtractorFactory
        +createPropsExtractor() Promise~BaseExtractor~
        +createInheritanceExtractor() Promise~BaseExtractor~
        +createVariantsExtractor() Promise~BaseExtractor~
        +createExamplesExtractor() Promise~BaseExtractor~
    }
    class BaseExtractor~TInput, TOutput~ {
        +extract(input) Promise~ExtractionResult~
    }
    class TypeScriptBaseExtractor~TInput, TOutput~ {
        #getSourceFile(filePath) Promise~SourceFile~
        #extractJSDocComment(node) string
        #extractJSDocTag(node, tagName) string
        #extractSeeTags(node) SeeTags
    }
    class PropsExtractor
    class InheritanceExtractor
    class VariantsExtractor
    class LocalTypesExtractor
    class ExamplesExtractor
    class ProgramCache {
        +getProgramBundle(configPath)$ ProgramBundle
        +parseTsConfig(configPath)$ ParsedCommandLine
    }

%% ---------- Phase 3 — Enrichment ----------
    class APIDataGenerator {
        +generate(components) Promise~APIData~
    }

%% ---------- Phase 4 — Generation ----------
    class GenerationCoordinator {
        +generateAll(components, apiData) Promise~GeneratedOutput[]~
        +validateConfiguration() ValidationResult
        +getGenerationPlan()
    }
    class APIFileGenerator {
        +generate(apiData) Promise~GeneratedOutput~
        +validateAPIData(apiData) void
    }
    class LLMDocumentationGenerator {
        -docsParser: SvelteDocsParser
        +generate(components, apiData) Promise~GeneratedOutput~
    }
    class MCPCatalogGenerator {
        +generate(components, apiData) Promise~ComponentCatalog~
    }
    class SvelteDocsParser {
        +parseDocsFile(componentName, docsFilePath) Promise~SvelteDocsParseResult~
    }
    class StaticDocsConfigError

%% ---------- Post-run assembly (CLI-driven, across packages) ----------
    class LlmsFullAssembler {
        +assemble() Promise~AssembleResult~
    }
    class MCPCatalogAssembler {
        +assemble() Promise~AssembleResult~
        +extractRecipeCode(content)$ string
    }
    class ContentBundleEmitter {
        +emit() Promise~ContentBundleResult~
    }

%% ==========================================
%% RELATIONSHIPS
%% ==========================================
    DocsGeneratorCLI --> ConfigurationFactory
    DocsGeneratorCLI --> PipelineOrchestrator
    DocsGeneratorCLI --> LlmsFullAssembler
    DocsGeneratorCLI --> MCPCatalogAssembler
    DocsGeneratorCLI --> ContentBundleEmitter
    ConfigurationFactory ..> DocsConfigurationBuilder

    PipelineOrchestrator --> ErrorHandler
    PipelineOrchestrator --> ComponentFinder
    PipelineOrchestrator --> ExtractionCoordinator
    PipelineOrchestrator --> APIDataGenerator
    PipelineOrchestrator --> GenerationCoordinator
    ErrorHandler ..> PipelineException

    ExtractionCoordinator --> ExtractorFactory
    ExtractionCoordinator ..> ProgramCache
    ExtractorFactory --> PropsExtractor
    ExtractorFactory --> InheritanceExtractor
    ExtractorFactory --> VariantsExtractor
    ExtractorFactory --> LocalTypesExtractor
    ExtractorFactory --> ExamplesExtractor

    BaseExtractor <|-- TypeScriptBaseExtractor
    TypeScriptBaseExtractor <|-- PropsExtractor
    TypeScriptBaseExtractor <|-- VariantsExtractor
    TypeScriptBaseExtractor <|-- InheritanceExtractor
    TypeScriptBaseExtractor <|-- LocalTypesExtractor
    TypeScriptBaseExtractor <|-- ExamplesExtractor
    TypeScriptBaseExtractor ..> ProgramCache

    GenerationCoordinator --> APIFileGenerator
    GenerationCoordinator --> LLMDocumentationGenerator
    GenerationCoordinator --> MCPCatalogGenerator
    LLMDocumentationGenerator --> SvelteDocsParser
    SvelteDocsParser ..> StaticDocsConfigError

    APIFileGenerator ..> LLMDocumentationGenerator : api.ts first
    APIFileGenerator ..> MCPCatalogGenerator : api.ts first

%% ---------- Architecture notes ----------
note for APIFileGenerator "API-FIRST: writes api.ts before the other generators run — they read it, not the raw components"
note for BaseExtractor "Template Method: extract() is the seam; TypeScriptBaseExtractor adds the shared ts/JSDoc infra"
note for TypeScriptBaseExtractor "Owns the JSDoc rules shared by props AND type declarations, incl. the @see link/prose split"
note for ProgramCache "One ts.Program per tsconfig, shared across extractors — cross-file type resolution depends on it"
note for SvelteDocsParser "Reads docs.svelte docsConfig; fails loud (StaticDocsConfigError) on a non-statically-evaluable config"
