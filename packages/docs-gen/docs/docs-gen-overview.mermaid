%% docs-gen architecture overview — the four pipeline phases and what the CLI
%% does around them. Verified against the sources on 2026-07-27; the previous
%% version still drew SveltePageGenerator, SectionMerger, TemplateEngine,
%% SectionRenderer, DeploymentManager, CrossReferenceResolver, ExampleValidator,
%% MetadataEnricher, FileStructureAnalyzer and MetadataExtractor, none of which
%% exist any more.
graph TB
%% CLI Layer
    CLI["DocsGeneratorCLI<br/>cli/CLI.ts"]
%% Configuration
    ConfigFactory["ConfigurationFactory<br/>schema/ConfigurationBuilder.ts"]
%% Main Pipeline
    Pipeline[PipelineOrchestrator]
    ErrorHandler[ErrorHandler]
%% Phase 1 — Discovery
    ComponentFinder[ComponentFinder]
%% Phase 2 — Extraction
    ExtractionCoord[ExtractionCoordinator]
    ExtractorFactory["ExtractorFactory<br/>(singleton)"]
    ProgramCache["ProgramCache<br/>(one ts.Program per tsconfig)"]
    PropsExtractor[PropsExtractor]
    InheritanceExtractor[InheritanceExtractor]
    VariantsExtractor[VariantsExtractor]
    LocalTypesExtractor[LocalTypesExtractor]
    ExamplesExtractor[ExamplesExtractor]
%% Phase 3 — Enrichment
    APIDataGen[APIDataGenerator]
%% Phase 4 — Generation
    GenerationCoord[GenerationCoordinator]
    APIFileGen[APIFileGenerator]
    LLMDocGen[LLMDocumentationGenerator]
    MCPCatalogGen[MCPCatalogGenerator]
    SvelteDocsParser["SvelteDocsParser<br/>(reads docs.svelte docsConfig)"]
%% Post-run assembly, driven by the CLI across all packages
    LlmsFull[LlmsFullAssembler]
    MCPAssembler[MCPCatalogAssembler]
    ContentBundle[ContentBundleEmitter]
%% CLI wiring
    CLI --> ConfigFactory
    CLI --> Pipeline
    CLI --> LlmsFull
    CLI --> MCPAssembler
    CLI --> ContentBundle
%% Pipeline phases, in order
    Pipeline --> ErrorHandler
    Pipeline -->|Phase 1| ComponentFinder
    Pipeline -->|Phase 2| ExtractionCoord
    Pipeline -->|Phase 3| APIDataGen
    Pipeline -->|Phase 4| GenerationCoord
%% Extraction
    ExtractionCoord --> ExtractorFactory
    ExtractionCoord --> ProgramCache
    ExtractorFactory --> PropsExtractor
    ExtractorFactory --> InheritanceExtractor
    ExtractorFactory --> VariantsExtractor
    ExtractorFactory --> LocalTypesExtractor
    ExtractorFactory --> ExamplesExtractor
    PropsExtractor -.->|shared program| ProgramCache
    InheritanceExtractor -.->|shared program| ProgramCache
    LocalTypesExtractor -.->|shared program| ProgramCache
%% Generation
    GenerationCoord --> APIFileGen
    GenerationCoord --> LLMDocGen
    GenerationCoord --> MCPCatalogGen
    LLMDocGen --> SvelteDocsParser
%% API-First
    APIFileGen -.->|api.ts FIRST| LLMDocGen
    APIFileGen -.->|api.ts FIRST| MCPCatalogGen
%% Key Architecture Decision Box
    subgraph "API-First"
        direction TB
        Note1["1. APIFileGenerator runs FIRST"]
        Note2["2. Writes api.ts with the complete component data"]
        Note3["3. LLM + MCP output are derived from that same data"]
        Note4["4. docs.svelte docsConfig filters what reaches llm.txt"]
        Note1 --> Note2
        Note2 --> Note3
        Note3 --> Note4
    end

%% Styling
    classDef cli fill: #e1f5fe
    classDef config fill: #f3e5f5
    classDef pipeline fill: #fff3e0
    classDef discovery fill: #e8f5e8
    classDef extraction fill: #fff9c4
    classDef enrichment fill: #fce4ec
    classDef generation fill: #e0f2f1
    classDef support fill: #f5f5f5
    classDef apifirst fill:#ffebee,stroke:#d32f2f,stroke-width:3px
class CLI cli
class ConfigFactory config
class Pipeline,ErrorHandler pipeline
class ComponentFinder discovery
class ExtractionCoord,ExtractorFactory,ProgramCache,PropsExtractor,InheritanceExtractor,VariantsExtractor,LocalTypesExtractor,ExamplesExtractor extraction
class APIDataGen enrichment
class GenerationCoord,APIFileGen,LLMDocGen,MCPCatalogGen,SvelteDocsParser generation
class LlmsFull,MCPAssembler,ContentBundle support
class APIFileGen apifirst
