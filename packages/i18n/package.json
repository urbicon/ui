{
  "name": "@urbicon-ui/i18n",
  "version": "6.44.0",
  "description": "Runes-based localization for Svelte 5 apps and the Urbicon UI design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/urbicon/ui.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://ui.urbicon.de",
  "bugs": "https://codeberg.org/urbicon/ui/issues",
  "keywords": [
    "svelte",
    "i18n",
    "internationalization",
    "localization",
    "urbicon-ui",
    "design-system"
  ],
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@urbicon-ui/shared-types": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    }
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__fixtures__/**",
    "README.md"
  ],
  "main": "dist/index.js",
  "sideEffects": false,
  "peerDependencies": {
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "@urbicon-ui/shared-types": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-kit sync && svelte-package && bun ../../scripts/complete-esm-specifiers.ts dist",
    "clean": "rm -rf dist .svelte-kit",
    "clean-all": "bun --bun run clean && rm -rf node_modules",
    "package": "svelte-kit sync && svelte-package && bun ../../scripts/complete-esm-specifiers.ts dist",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome format --write . && prettier --write \"**/*.svelte\"",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "svelte": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts"
}
