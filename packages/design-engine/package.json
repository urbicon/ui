{
  "name": "@urbicon-ui/design-engine",
  "version": "8.18.0",
  "description": "Deterministic design engine for Urbicon UI — the zero-dependency design linter, manifest parser and quality rubric that power the design loop (validate · context · judge).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbicon/ui.git",
    "directory": "packages/design-engine"
  },
  "homepage": "https://ui.urbicon.de",
  "bugs": "https://github.com/urbicon/ui/issues",
  "keywords": [
    "design-system",
    "linter",
    "design-tokens",
    "urbicon-ui",
    "ai"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./linter": "./src/linter/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./reference": "./src/reference/index.ts",
    "./rubric": "./src/rubric/index.ts",
    "./search": "./src/search/index.ts"
  },
  "files": [
    "LICENSE",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'no build needed — Bun runs TypeScript directly'",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "author": "Urbicon UI Team"
}
